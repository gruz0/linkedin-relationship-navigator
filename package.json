{
  "name": "linkedin-relationship-navigator",
  "private": true,
  "version": "0.4.0",
  "packageManager": "bun@1.3.14",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "capture:showcase": "bun scripts/capture-showcase.ts",
    "check": "biome check . && knip",
    "check:ci": "biome ci . && knip",
    "check:fix": "biome check --write .",
    "dev": "vite",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "lucide-react": "1.46.0",
    "papaparse": "5.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "knip": "6.36.0",
    "playwright-core": "1.62.1",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
